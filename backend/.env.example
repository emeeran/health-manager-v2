# ── Application ──────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
DEBUG=true
# Leave empty in dev (derived from SECRET_KEY); MUST be set in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/health.db

# ── AI (local-first; per-household config overrides in-app) ──
# Ollama endpoint used for local models; cloud providers are configured
# per household in Settings → AI Providers (or instance-wide via /system).
OLLAMA_BASE_URL=http://localhost:11434

# ── Audit agent: optional external fact-checking (SearXNG) ──
# The claim audit always runs locally against the member's records. Web
# checking is off unless WEB_FACTCHECK_ENABLED=true, SEARXNG_URL points at
# an instance, AND the member opts in from their profile. Queries are
# redacted in code (no names, dates, or identifiers).
WEB_FACTCHECK_ENABLED=false
SEARXNG_URL=
SEARXNG_TIMEOUT=10
WEB_FACTCHECK_MAX_CLAIMS=5
WEB_FACTCHECK_MAX_RESULTS=5
# Max claims examined per narrative (local pass).
AUDIT_MAX_CLAIMS=15

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────
ALLOW_REGISTRATION=true

# ── Web push (VAPID) ─────────────────────────────────────
# Generate a keypair once:
#   uv run python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key, v.public_key)"
# or use any EC P-256 source; keys are urlsafe-base64 without padding.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:ops@localhost

# ── Rate limiting ────────────────────────────────────────
# Empty = in-memory sliding window (default). Set to share limits across
# replicas; falls back to in-memory automatically if Redis is unreachable.
# REDIS_URL=redis://localhost:6379/0

# ── Ops endpoints ────────────────────────────────────────
# Required by GET /health/detail (returned 403 without it).
# HEALTH_KEY=

# ── Jan Aushadhi catalog ─────────────────────────────────
# Optional override for the bundled PMBJP export (seed via
#   uv run python -m app.scripts.seed_jan_aushadhi
# or pass a path; the bundled app/data/jan_aushadhi_products.csv is the default).
# JAN_AUSHADHI_CSV=
