{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Health Manager v2",
  "version": "1.3.0",
  "identifier": "com.healthmanager.v2",
  "build": {
    "frontendDist": "../desktop/stub",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Family Health Manager v2",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; object-src 'none'"
    },
    "trayIcon": {
      "id": "main-tray",
      "tooltip": "Family Health Manager v2",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "category": "Medical",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "binaries/health-manager-backend/": "backend/"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "mainBinaryName": "health-manager-v2",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
