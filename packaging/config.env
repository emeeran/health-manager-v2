# ── health-manager server configuration (conffile) ──────────────────
APP_ENV=production
DEBUG=false

# Secrets are generated by postinst on install if empty. ENCRYPTION_KEY
# is independent of SECRET_KEY so JWT rotation can't brick encrypted data.
SECRET_KEY=
ENCRYPTION_KEY=
HEALTH_CHECK_SECRET=

# ── Database / storage ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////var/lib/health-manager/data/health.db
STORAGE_PATH=/var/lib/health-manager/data/attachments

# ── HTTP ────────────────────────────────────────────────────────────
PORT=8080
CORS_ORIGINS=
ALLOW_REGISTRATION=false

# ── AI ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Cloud fallbacks (optional, also settable per-household later):
#OPENAI_API_KEY=
#GROQ_API_KEY=
